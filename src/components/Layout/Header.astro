---
import { Schema } from 'astro-seo-schema'
import "../../styles/global.css";

const { title, description, schemaData } = Astro.props

// Google Analytics (gtag.js) loaded via Partytown (offloaded to a web worker).
const GA_ID = "G-PQRJQQNM";
const gtagSnippet = `
	<script type="text/partytown" src="https://www.googletagmanager.com/gtag/js?id=${GA_ID}"></script>
	<script type="text/partytown">
		window.dataLayer = window.dataLayer || [];
		window.gtag = function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());
		gtag('config', '${GA_ID}');
	</script>
`;
---
<head>
	<title>{title ? title : 'Default Title'}</title>
		<meta
			name="description"
			content={description ? description : 'Default site description'}
		/>
		<meta charset="UTF-8" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/assets/favicon.ico">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.1.0/dist/cookieconsent.css">

		<meta name="google-site-verification" content="EtZcuOhLAz4SNqrZtPY9nRSHvzTE_xXlc45DQDYP8QQ" />
		<Fragment set:html={gtagSnippet} />

</head>